{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    "./.opencode/plugins/ccgs-hooks.ts",
    "./.opencode/plugins/drift-detector.ts",
    "./.opencode/plugins/changelog-generator.ts"
  ],
  "command": {
    "hybrid-prototype": {
      "template": "Run the hybrid-prototype skill: load .opencode/skills/hybrid-prototype/SKILL.md and follow the fast-lane prototype workflow. Concept: $ARGUMENTS",
      "description": "Fast-lane prototype for discovery phase \u2014 build a playable prototype in 2-3 days with minimal process overhead.",
      "agent": "prototyper"
    }
  },
  "mcp": {
    "aseprite": {
      "enabled": false,
      "type": "local",
      "command": [
        "uv",
        "--directory",
        "tools/aseprite-mcp",
        "run",
        "-m",
        "aseprite_mcp"
      ],
      "environment": {
        "ASEPRITE_PATH": "{env:ASEPRITE_PATH}"
      }
    },
    "blender-mcp": {
      "enabled": false,
      "type": "local",
      "command": [
        "uvx",
        "blender-mcp"
      ],
      "environment": {
        "BLENDER_HOST": "localhost",
        "BLENDER_PORT": "9876"
      }
    },
    "unity-coplay": {
      "enabled": false,
      "type": "remote",
      "url": "http://127.0.0.1:8080/mcp"
    },
    "unity-cli": {
      "enabled": false,
      "type": "local",
      "command": [
        "powershell.exe",
        "-NoProfile",
        "-Command",
        "\u0026 \u0027C:\\Users\\Johnatas\\AppData\\Local\\Unity\\bin\\unity.exe\u0027 mcp --project-path D:/projects/overdrive"
      ]
    },
    "ai-game-developer": {
      "enabled": true,
      "type": "remote",
      "url": "http://localhost:8081/p/55a3e7c2"
    }
  },
  "permission": {
    "bash": {
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git branch*": "allow",
      "git rev-parse*": "allow",
      "ls *": "allow",
      "dir *": "allow",
      "python -m json.tool*": "allow",
      "python -m pytest*": "allow",
      "py -m pytest*": "allow",
      "rm -rf *": "deny",
      "git push --force*": "deny",
      "git push -f *": "deny",
      "git reset --hard*": "deny",
      "git clean -f*": "deny",
      "sudo *": "deny",
      "chmod 777*": "deny",
      "*\u003E.env*": "deny",
      "cat *.env*": "deny",
      "type *.env*": "deny"
    },
    "read": {
      "~/.config/opencode/*": "allow",
      "**/.env*": "deny"
    }
  }
}